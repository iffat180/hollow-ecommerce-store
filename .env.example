# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/hollow

# --- Stripe ---
# Secret key: Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_xxx
# Publishable key (safe to expose to the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret for /api/webhooks/stripe
#   local:      run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#   production: Stripe Dashboard > Developers > Webhooks > (your endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- App ---
# Absolute URL of this site, used for Stripe success/cancel redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated origins allowed to call /api/* cross-origin (CORS allowlist).
# The web frontend is same-origin and doesn't need this; it's for other clients.
# *.vercel.app preview deployments are allowed automatically.
CORS_ALLOWED_ORIGINS=http://localhost:3000
